# ===========================================================
# Jira 小幫手環境變數樣板
# 1) 複製為 ops/.env（不入 Git）
# 2) 各使用者於 prod / staging / dev 各自填寫
# 3) 任何更動同步更新此檔案 + research.md R-010
# ===========================================================

# ------ Atlassian OAuth 2.0（spec FR-001 / research R-002）------
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
ATLASSIAN_OAUTH_SCOPES=read:jira-work read:jira-user write:jira-work offline_access

# ------ MCP server（research R-001）------
MCP_ATLASSIAN_URL=http://mcp-atlassian:9000/sse

# ------ LLM（research R-003）------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001

# ------ PostgreSQL ------
POSTGRES_USER=jiracheck
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=jiracheck
DATABASE_URL=postgres://jiracheck:change-me-in-production@postgres:5432/jiracheck

# ------ Token 加密金鑰（32 bytes base64；切勿在 prod 重用）------
# 產生：openssl rand -base64 32
TOKEN_ENC_KEY=

# ------ Server ------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ------ Jira 自訂欄位 ID（依各組織不同）------
# 取值方式：到 Jira 設定 → 自訂欄位 → 各欄位的 customfield_xxxxx
JIRA_FIELD_STORY_POINTS=customfield_10016
JIRA_FIELD_ACTUAL_STORY_POINTS=customfield_10100
JIRA_FIELD_SPRINT=customfield_10020

# ------ 排程服務（feature 002-scheduled-services；research R-002 / R-006 / R-009）------
# 管理者 Atlassian accountId 白名單（逗號分隔；可在登入後從 /api/v1/me.accountId 取得）
ADMIN_ACCOUNT_IDS=
# 排程觸發時區（spec FR-008；預設 Asia/Taipei）
SERVER_TZ=Asia/Taipei
# CHKISSUE 連續 N 次無任務後警示門檻
CHKISSUE_EMPTY_STREAK_THRESHOLD=4
