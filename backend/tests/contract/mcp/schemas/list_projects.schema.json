{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jiracheck.local/mcp/list_projects.schema.json",
  "title": "mcp-atlassian list_projects 回應",
  "type": "object",
  "required": ["projects"],
  "properties": {
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "name": { "type": "string" },
          "id": { "type": ["string", "integer"] },
          "avatarUrl": { "type": "string", "format": "uri" },
          "lead": {
            "type": "object",
            "properties": {
              "accountId": { "type": "string" },
              "displayName": { "type": "string" }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
