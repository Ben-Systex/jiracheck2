{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jiracheck.local/mcp/search_issues.schema.json",
  "title": "mcp-atlassian search_issues 回應",
  "type": "object",
  "required": ["issues"],
  "properties": {
    "total": { "type": "integer", "minimum": 0 },
    "startAt": { "type": "integer", "minimum": 0 },
    "maxResults": { "type": "integer", "minimum": 0 },
    "nextPageToken": { "type": ["string", "null"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "fields"],
        "properties": {
          "key": { "type": "string" },
          "id": { "type": ["string", "integer"] },
          "fields": {
            "type": "object",
            "properties": {
              "summary": { "type": "string" },
              "status": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" }
                }
              },
              "assignee": {
                "type": ["object", "null"],
                "properties": {
                  "accountId": { "type": "string" },
                  "displayName": { "type": "string" }
                }
              },
              "priority": {
                "type": ["object", "null"],
                "properties": { "name": { "type": "string" } }
              },
              "duedate": { "type": ["string", "null"], "format": "date" },
              "labels": { "type": "array", "items": { "type": "string" } },
              "project": {
                "type": "object",
                "properties": { "key": { "type": "string" } }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
